<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backButton"
                style="@style/MAL.SecondaryButton"
                android:layout_width="52dp"
                android:layout_height="42dp"
                android:text="返回" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="备份中心"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GitHub 和手机本地备份可以分别选择网页、备份频率和保存位置。备份会保存 MAL 管理的网页、分类、图标、桌面快捷方式映射和基础设置；不会上传网站 Cookie、密码、OAuth 登录会话、网页自己的 IndexedDB/LocalStorage 或 GitHub Token。"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="GitHub 云端备份"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/githubOwnerInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_url_input"
                android:hint="GitHub 用户名 / 组织名"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/soft_text" />

            <EditText
                android:id="@+id/githubRepoInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_url_input"
                android:hint="仓库名，例如 MAL-Backup"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/soft_text" />

            <EditText
                android:id="@+id/githubBranchInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_url_input"
                android:hint="分支，默认 main"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/soft_text" />

            <EditText
                android:id="@+id/githubPathInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_url_input"
                android:hint="备份路径，例如 backups/mal-backup.json"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/soft_text" />

            <EditText
                android:id="@+id/githubTokenInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_url_input"
                android:hint="GitHub Personal Access Token"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/soft_text" />

            <TextView
                android:id="@+id/githubSelectionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="GitHub 备份网页：未选择"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <Button
                android:id="@+id/githubSelectSitesButton"
                style="@style/MAL.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="选择 GitHub 要备份的网页" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/githubAutoSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="自动 GitHub 备份"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自动备份频率"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/githubFrequencySpinner"
                    android:layout_width="150dp"
                    android:layout_height="44dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/githubTestButton"
                    style="@style/MAL.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="测试连接" />

                <Button
                    android:id="@+id/githubBackupButton"
                    style="@style/MAL.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="立即备份" />
            </LinearLayout>

            <Button
                android:id="@+id/githubRestoreButton"
                style="@style/MAL.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="9dp"
                android:text="从 GitHub 恢复最新备份" />

            <TextView
                android:id="@+id/githubStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="未操作"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="自动下载到手机"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/localSelectionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="手机下载网页：未选择"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <Button
                android:id="@+id/localSelectSitesButton"
                style="@style/MAL.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="选择自动下载要备份的网页" />

            <TextView
                android:id="@+id/localFolderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="保存位置：下载/MAL/Backups"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <Button
                android:id="@+id/localChooseFolderButton"
                style="@style/MAL.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="选择手机备份文件夹" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/localAutoSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="自动下载备份"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自动下载频率"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/localFrequencySpinner"
                    android:layout_width="150dp"
                    android:layout_height="44dp" />
            </LinearLayout>

            <Button
                android:id="@+id/localBackupButton"
                style="@style/MAL.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="现在下载一份备份" />

            <Button
                android:id="@+id/localRestoreButton"
                style="@style/MAL.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="9dp"
                android:text="从手机备份文件恢复" />

            <TextView
                android:id="@+id/localStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="未操作"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="说明：GitHub 建议使用 Private 仓库。Fine-grained Token 只给目标仓库的 Contents: Read and write 权限即可。自动任务会按你选择的频率尽力执行；Android 省电/休眠可能延后后台任务，但下次打开 MAL 时会自动补做到期备份。"
            android:textColor="@color/soft_text"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
